---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const BASE = import.meta.env.BASE_URL;

const {
  title,
  description = 'Ali Parchekani — PhD Candidate, Educator, and Engineer at the University of Toronto.',
  ogImage = `${BASE}/og-default.png`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { label: 'Teaching', href: `${BASE}/teaching/` },
  { label: 'Tutoring', href: `${BASE}/tutoring/` },
  { label: 'Research', href: `${BASE}/research/` },
  { label: 'Industry', href: `${BASE}/industry/` },
  { label: 'About', href: `${BASE}/about/` },
  { label: 'Contact', href: `${BASE}/contact/` },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Ali Parchekani</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Set theme before first paint to avoid flash -->
    <script is:inline>
      document.documentElement.classList.add('js');
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="bg-paper-warm text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-blue-700 focus:text-on-accent focus:px-4 focus:py-2 focus:rounded"
    >Skip to main content</a>

    <!-- Decorative background: fine grid + signal arcs (wireless-sensing motif) -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute inset-0 bg-deco-grid"></div>
      <svg
        class="absolute -top-24 -right-24 w-[480px] h-[480px] md:w-[640px] md:h-[640px] text-blue-700 opacity-[0.06] dark:opacity-[0.08]"
        viewBox="0 0 640 640" fill="none" stroke="currentColor" stroke-width="1.2"
      >
        <circle cx="320" cy="320" r="70" />
        <circle cx="320" cy="320" r="140" />
        <circle cx="320" cy="320" r="210" />
        <circle cx="320" cy="320" r="280" stroke-dasharray="3 9" />
        <circle cx="320" cy="320" r="6" fill="currentColor" stroke="none" />
        <path d="M320 320 L580 120" stroke-dasharray="2 7" />
        <circle cx="580" cy="120" r="4" fill="currentColor" stroke="none" />
        <path d="M320 320 L120 540" stroke-dasharray="2 7" />
        <circle cx="120" cy="540" r="4" fill="currentColor" stroke="none" />
      </svg>
    </div>

    <!-- Header / Nav -->
    <header class="sticky top-0 z-40 bg-paper-warm/95 backdrop-blur border-b border-line-soft">
      <nav class="max-w-6xl mx-auto px-5 sm:px-8 flex items-center justify-between h-16" aria-label="Main navigation">
        <a href={`${BASE}/`} class="font-mono text-[13px] tracking-tight text-ink hover:text-blue-700 transition-colors">
          ALI PARCHEKANI <span class="text-muted-2 hidden sm:inline">— U OF T / ECE</span>
        </a>

        <div class="flex items-center gap-2">
          <ul class="hidden md:flex items-center gap-7 font-mono text-[12.5px] uppercase tracking-[0.06em] text-muted mr-3">
            {nav.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class={`nav-link transition-colors hover:text-blue-700 ${isActive(href) ? 'text-blue-700' : ''}`}
                  aria-current={isActive(href) ? 'page' : undefined}
                >{label}</a>
              </li>
            ))}
          </ul>

          <!-- Theme toggle -->
          <button
            id="theme-toggle"
            class="p-2 text-muted hover:text-blue-700 transition-colors"
            aria-label="Toggle dark mode"
          >
            <svg class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75 9.75 9.75 0 018.25 6c0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/>
            </svg>
            <svg class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
            </svg>
          </button>

          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 -mr-2 text-muted hover:text-blue-700"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-line-soft bg-paper-warm px-5 pb-4">
        <ul class="mt-2 flex flex-col font-mono text-[13px] uppercase tracking-[0.06em]">
          {nav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class={`block py-3 border-b border-line-soft transition-colors hover:text-blue-700 ${isActive(href) ? 'text-blue-700' : 'text-muted'}`}
                aria-current={isActive(href) ? 'page' : undefined}
              >{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 border-t-2 border-ink mt-24 bg-paper-warm">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-10">
        <div class="grid md:grid-cols-[200px_1fr] gap-6">
          <p class="font-mono text-[12px] uppercase tracking-[0.1em] text-ink leading-relaxed">Ali<br />Parchekani</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[12px] uppercase tracking-[0.06em] text-muted">
            <a href="mailto:aliparchekan@gmail.com" class="hover:text-blue-700 transition-colors">Email</a>
            <a href="https://www.linkedin.com/in/ali-parchekani-6a2978b0/" target="_blank" rel="noopener" class="hover:text-blue-700 transition-colors">LinkedIn</a>
            <a href="https://github.com/aliparchekan" target="_blank" rel="noopener" class="hover:text-blue-700 transition-colors">GitHub</a>
            <a href="https://scholar.google.com/citations?user=soH-zaAAAAAJ&hl=en" target="_blank" rel="noopener" class="hover:text-blue-700 transition-colors">Scholar</a>
          </div>
        </div>
        <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-2">© {new Date().getFullYear()} Ali Parchekani · Toronto, ON, Canada</p>
      </div>
    </footer>

    <script>
      // Mobile menu
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });

      // Theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {}
      });

      // Scroll-reveal
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -36px 0px' }
        );
        els.forEach((el) => {
          const delay = el.dataset.reveal;
          if (delay) el.style.transitionDelay = `${delay}ms`;
          io.observe(el);
        });
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
