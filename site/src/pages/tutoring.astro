---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

const BASE = import.meta.env.BASE_URL;

const subjects = [
  {
    category: 'Foundations',
    items: 'Calculus, advanced functions, linear algebra, probability, statistics, physics, mechanics, programming fundamentals, Python, MATLAB',
  },
  {
    category: 'University STEM',
    items: 'Data structures, algorithms, data science, AI foundations, ML, signals & systems, engineering math, computer networks',
  },
  {
    category: 'Advanced Mentorship',
    items: 'AI/ML & data-science projects, research prep, technical writing',
  },
];

const approach = [
  { step: '01', title: 'Diagnostic first session', desc: 'Identify gaps, goals, and learning style.' },
  { step: '02', title: 'Step-by-step concept repair', desc: 'Fix foundations before advancing.' },
  { step: '03', title: 'Guided practice', desc: 'Work through problems together with scaffolded support.' },
  { step: '04', title: 'Exam strategy', desc: 'Targeted prep for high-stakes assessments.' },
  { step: '05', title: 'Project support', desc: 'Hands-on guidance for assignments and independent projects.' },
  { step: '06', title: 'Progress communication', desc: 'Clear updates so students and families know where things stand.' },
];

const testimonials = [
  {
    text: 'Explained the concepts clearly and helped students during activities.',
    level: 'Pre-university, AI & Game Design',
  },
  {
    text: 'I felt I learned more from asking you questions than from following the projector screen — I\'m glad I had you as the instructor.',
    level: 'Pre-university, AI & Game Design',
  },
  {
    text: 'His way of explaining is straightforward and helpful.',
    level: 'University, Calculus',
  },
  {
    text: 'The steps were broken down and explained thoroughly — there was reasoning behind each step.',
    level: 'University, Calculus',
  },
];

const mailto = 'mailto:aliparchekan@gmail.com?subject=Tutoring%20inquiry%20%E2%80%94%20%5Bsubject%20%2F%20level%5D';
---

<Layout
  title="Tutoring"
  description="PhD-level, high-touch STEM tutoring with Ali Parchekani. High school, university, and graduate-level subjects including calculus, AI, ML, Python, and more."
>
  <PageHero
    eyebrow="Premium Tutoring"
    title="STEM Tutoring & Mentorship"
    intro="PhD-level, high-touch tutoring and academic mentorship for ambitious learners — from high school through graduate and professional study."
  />
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8" data-reveal>
    <a href={mailto} class="inline-flex items-center gap-2 bg-blue-700 text-on-accent font-semibold px-6 py-3 hover:bg-blue-500 transition-colors text-sm">
      Book a consultation
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 space-y-20">

    <!-- Best-fit students -->
    <section>
      <SectionHeading eyebrow="Best Fit" title="Who I Work With" />
      <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-3 text-[15px] text-ink" data-reveal>
        {[
          'High school, IB, AP, and pre-university students',
          'First-year university students in calculus, physics, stats, programming, or engineering',
          'Undergrads needing course rescue or exam prep',
          'Graduate students and professionals learning Python, MATLAB, AI, ML, or data science',
        ].map((item) => (
          <li class="flex items-start gap-3 border-b border-line-soft pb-3">
            <span class="text-blue-500 mt-0.5 font-mono text-[13px]" aria-hidden="true">▸</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <!-- Subjects -->
    <section>
      <SectionHeading eyebrow="Curriculum" title="Core Subjects" />
      <div class="grid md:grid-cols-3 gap-px bg-line border border-line">
        {subjects.map(({ category, items }, i) => (
          <div class="bg-paper-warm p-6 sm:p-7" data-reveal={String(i * 80)}>
            <h3 class="font-serif font-semibold text-xl text-blue-700 mb-3">{category}</h3>
            <p class="text-sm text-muted leading-relaxed">{items}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Approach -->
    <section>
      <SectionHeading eyebrow="Method" title="My Approach" />
      <ol class="grid sm:grid-cols-2 gap-x-10 gap-y-6">
        {approach.map(({ step, title, desc }, i) => (
          <li class="flex gap-5 items-start border-b border-line-soft pb-6" data-reveal={String((i % 2) * 80)}>
            <span class="font-mono text-[14px] text-blue-500 pt-0.5">{step}</span>
            <div>
              <h3 class="font-serif font-semibold text-lg text-ink">{title}</h3>
              <p class="text-sm text-muted mt-1 leading-relaxed">{desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Testimonials -->
    <section>
      <SectionHeading
        eyebrow="Feedback"
        title="Student Feedback"
        note="Anonymized evaluations. Full evaluations available on request."
      />
      <ul class="grid md:grid-cols-2 gap-px bg-line border border-line">
        {testimonials.map(({ text, level }, i) => (
          <li class="bg-paper-warm p-6 sm:p-7" data-reveal={String((i % 2) * 80)}>
            <blockquote class="font-serif italic text-[17px] leading-relaxed text-ink">“{text}”</blockquote>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.06em] text-muted-2">{level}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Availability & CTA -->
    <section class="border-t-2 border-ink pt-8" data-reveal>
      <p class="eyebrow text-[11.5px] text-blue-500 mb-3">Availability & Rates</p>
      <p class="font-serif text-xl md:text-2xl text-ink leading-relaxed max-w-2xl">
        Toronto/GTA in-person and online. Canadian and international students welcome.
        Rates by consultation.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-5">
        <a
          href={mailto}
          class="inline-flex items-center gap-2 bg-blue-700 text-on-accent font-semibold px-6 py-3 hover:bg-blue-500 transition-colors"
        >
          Book a consultation
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
        <a
          href={`${BASE}/files/premium-tutoring-profile.pdf`}
          class="font-mono text-[12px] uppercase tracking-[0.06em] text-blue-700 underline underline-offset-4 hover:text-blue-500 transition-colors"
          target="_blank"
          rel="noopener"
        >Premium Tutoring Profile (PDF)</a>
      </div>
    </section>

  </div>
</Layout>
