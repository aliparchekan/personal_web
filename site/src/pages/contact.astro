---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Ali Parchekani — for teaching opportunities, tutoring bookings, or engineering collaborations."
>
  <PageHero
    eyebrow="Get in Touch"
    title="Contact"
    intro="Whether you're a hiring committee, prospective tutoring client, or potential collaborator — I'd be glad to hear from you. Email is the best way to reach me."
  />

  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8" data-reveal>
    <a
      href="mailto:aliparchekan@gmail.com"
      class="inline-flex items-center gap-2 bg-blue-700 text-on-accent font-semibold px-6 py-3 hover:bg-blue-500 transition-colors text-sm"
    >
      Email aliparchekan@gmail.com
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16">
    <div class="grid md:grid-cols-2 gap-14">

      <!-- Contact info -->
      <div>
        <SectionHeading eyebrow="Direct" title="Direct Contact" />

        <div class="space-y-6" data-reveal>
          <div class="flex items-start gap-4">
            <svg class="h-5 w-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2">Email</p>
              <a href="mailto:aliparchekan@gmail.com" class="text-blue-700 font-semibold hover:text-blue-500 transition-colors">aliparchekan@gmail.com</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="h-5 w-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2">Location</p>
              <p class="text-ink font-medium">Toronto, ON, Canada</p>
              <p class="text-xs text-muted-2 mt-0.5">Toronto/GTA in-person · online globally</p>
            </div>
          </div>
        </div>

        <!-- Social links -->
        <div class="mt-10 pt-6 border-t border-line space-y-3" data-reveal>
          <h3 class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2">Profiles</h3>
          {[
            { label: 'LinkedIn', href: 'https://www.linkedin.com/in/ali-parchekani-6a2978b0/' },
            { label: 'GitHub', href: 'https://github.com/aliparchekan' },
            { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=soH-zaAAAAAJ&hl=en' },
          ].map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 text-blue-700 hover:text-blue-500 font-medium text-sm transition-colors"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              {label}
            </a>
          ))}
        </div>
      </div>

      <!-- Quick-contact mailto form -->
      <div>
        <SectionHeading eyebrow="Message" title="Send a Message" />
        <form
          action="mailto:aliparchekan@gmail.com"
          method="get"
          enctype="text/plain"
          class="space-y-5"
          aria-label="Contact form"
          data-reveal
        >
          <div>
            <label for="contact-name" class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2 mb-1.5">Your name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              class="w-full bg-paper border border-line px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
              placeholder="Jane Smith"
            />
          </div>
          <div>
            <label for="contact-subject" class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2 mb-1.5">Subject</label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full bg-paper border border-line px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
            >
              <option value="Teaching opportunity">Teaching opportunity</option>
              <option value="Tutoring inquiry">Tutoring inquiry</option>
              <option value="Research collaboration">Research collaboration</option>
              <option value="Industry inquiry">Industry inquiry</option>
              <option value="General">General</option>
            </select>
          </div>
          <div>
            <label for="contact-body" class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted-2 mb-1.5">Message</label>
            <textarea
              id="contact-body"
              name="body"
              rows="5"
              class="w-full bg-paper border border-line px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition resize-y"
              placeholder="Hi Ali, ..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-blue-700 text-on-accent font-semibold py-3 hover:bg-blue-500 transition-colors"
          >
            Open in email client
          </button>
          <p class="text-xs text-muted-2">This form opens your default email client with a pre-filled message.</p>
        </form>
      </div>
    </div>
  </div>
</Layout>
