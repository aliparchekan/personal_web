---
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL;

const rows = [
  {
    n: '01',
    title: 'Teaching',
    meta: 'For hiring committees',
    desc: 'University instructor and TA across 40+ distinct UofT courses. Intuition-first explanation, structured problem solving, and consistently strong student evaluations.',
    cta: 'Hire me to teach',
    href: `${BASE}/teaching/`,
  },
  {
    n: '02',
    title: 'Tutoring',
    meta: 'For students & families',
    desc: 'Premium, high-touch 1:1 STEM coaching in mathematics, physics, statistics, programming, and computer science — built around each student.',
    cta: 'Book tutoring',
    href: `${BASE}/tutoring/`,
  },
  {
    n: '03',
    title: 'Industry',
    meta: 'For engineering teams',
    desc: 'Applied machine learning, wireless sensing, and agentic-AI systems — taken from research to production.',
    cta: 'See my engineering work',
    href: `${BASE}/industry/`,
  },
];

const highlights = [
  { meta: 'Experience', text: '6+ years applied ML & research' },
  { meta: 'Research', text: '4 peer-reviewed IEEE papers' },
  { meta: 'Teaching', text: '40+ distinct UofT courses taught / TA’d' },
  { meta: 'Industry', text: '50% radar detection-accuracy gain' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ali Parchekani',
  jobTitle: 'PhD Candidate, Educator, and Engineer',
  affiliation: { '@type': 'EducationalOrganization', name: 'University of Toronto' },
  email: 'aliparchekan@gmail.com',
  telephone: '+16477667304',
  address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' },
  url: 'https://aliparchekan.github.io/personal_web_claude/',
  sameAs: [
    'https://www.linkedin.com/in/ali-parchekani-6a2978b0/',
    'https://github.com/aliparchekan',
    'https://scholar.google.com/citations?user=soH-zaAAAAAJ&hl=en',
  ],
};
---

<Layout
  title="Home"
  description="Ali Parchekani — PhD Candidate, Educator, and Engineer at the University of Toronto. Academic teaching, premium STEM tutoring, and applied ML engineering."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero -->
  <header class="max-w-6xl mx-auto px-5 sm:px-8 pt-16 md:pt-20 pb-12">
    <div class="grid md:grid-cols-[1fr_0.42fr] gap-10 items-end">
      <div>
        <p class="eyebrow text-[12.5px] text-blue-500" data-reveal>PhD Candidate · Educator · Engineer</p>
        <h1 class="font-serif font-semibold text-[15vw] sm:text-7xl md:text-8xl leading-[0.94] tracking-[-0.035em] mt-4" data-reveal="80">
          Ali<br />Parchekani
        </h1>
        <p class="font-serif italic text-2xl md:text-[34px] text-blue-700 mt-5 tracking-tight" data-reveal="160">
          PhD Candidate, Educator, and Engineer
        </p>
      </div>
      <p class="text-base md:text-[16.5px] leading-relaxed text-muted border-l-2 border-blue-700 pl-5" data-reveal="240">
        University of Toronto ECE PhD candidate. I teach technical subjects clearly,
        mentor ambitious students, and build AI and wireless systems — where research rigor,
        teaching, and production machine learning meet.
      </p>
    </div>
  </header>

  <!-- Index list -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8" aria-label="What I do">
    <ul class="border-t-2 border-ink">
      {rows.map(({ n, title, meta, desc, cta, href }, i) => (
        <li data-reveal={String(i * 90)}>
          <a
            href={href}
            class="group grid grid-cols-[40px_1fr_auto] sm:grid-cols-[78px_1fr_auto] gap-4 sm:gap-7 items-center py-7 sm:py-8 border-b border-line transition-colors hover:bg-paper"
          >
            <span class="font-mono text-[13px] sm:text-[14px] text-blue-500 self-start pt-2">{n}</span>
            <div>
              <span class="eyebrow text-[11.5px] text-muted-2 block mb-1.5">{meta}</span>
              <h2 class="font-serif font-semibold text-2xl sm:text-[38px] leading-[1.05] tracking-[-0.02em] text-ink">{title}</h2>
              <p class="text-sm sm:text-[15px] leading-relaxed text-muted mt-2 max-w-xl">{desc}</p>
              <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-blue-700 mt-3 inline-block">{cta} →</span>
            </div>
            <span class="hidden sm:flex text-blue-700 transition-transform group-hover:translate-x-1.5" aria-hidden="true">
              <svg width="30" height="16" viewBox="0 0 30 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 8h26M21 1.5 27.5 8 21 14.5"/>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Selected highlights -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 mt-6" aria-label="Selected highlights">
    <div class="border-t-2 border-ink grid md:grid-cols-[200px_1fr]">
      <div class="py-8 md:pr-7">
        <p class="font-mono text-[12px] uppercase tracking-[0.1em] text-ink leading-relaxed">Selected<br />Highlights</p>
      </div>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-4">
        {highlights.map(({ meta, text }, i) => (
          <li class="py-8 sm:px-7 border-t sm:border-t-0 sm:border-l border-line first:border-t-0" data-reveal={String(i * 70)}>
            <p class="font-mono text-[11px] uppercase tracking-[0.06em] text-blue-500">{meta}</p>
            <p class="text-[15.5px] leading-snug mt-2.5 text-ink">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Short bio -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 mt-20">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow text-[12px] text-blue-500 mb-4">About</p>
      <p class="font-serif text-xl md:text-2xl leading-relaxed text-ink">
        University of Toronto Electrical &amp; Computer Engineering PhD candidate specializing in
        wireless sensing, signal processing, optimization, and applied machine learning, with a recent
        focus on agentic AI systems. Alongside research, an experienced educator across 40+ distinct
        UofT courses and instructor of pre-university statistics, AI, and game-design courses.
      </p>
      <a href={`${BASE}/about/`} class="font-mono text-[12px] uppercase tracking-[0.06em] text-blue-700 mt-6 inline-block hover:text-blue-500 transition-colors">
        Read my full bio →
      </a>
    </div>
  </section>
</Layout>
